# CMakeEmbedTheme.cmake
#
# Compiles the theme a module is dressed in by default into its library.
#
#   static const Byte kTheme[] = { 0x7b, ... };
#
# The module is named by the folder its target is declared in, as UI.Control, so its sources include the bytes as
# "UI.Control/Theme.inl". Editing the theme configures the project again, which writes the bytes anew.
#
# Usage:
#   ZyEmbedTheme(TARGET <target> FILE <theme>)
FUNCTION(ZyEmbedTheme)

    SET(OPTIONS)
    SET(ONE_VALUE_ARGS TARGET FILE)
    SET(MULTI_VALUE_ARGS)

    CMAKE_PARSE_ARGUMENTS(ARG "${OPTIONS}" "${ONE_VALUE_ARGS}" "${MULTI_VALUE_ARGS}" ${ARGN})

    IF(NOT ARG_TARGET)

        MESSAGE(FATAL_ERROR "ZyEmbedTheme: TARGET is required.")

    ENDIF()

    IF(NOT ARG_FILE)

        MESSAGE(FATAL_ERROR "ZyEmbedTheme: FILE is required.")

    ENDIF()

    GET_FILENAME_COMPONENT(THEME "${ARG_FILE}" ABSOLUTE)

    IF(NOT EXISTS "${THEME}")

        MESSAGE(FATAL_ERROR "ZyEmbedTheme: ${THEME} does not exist.")

    ENDIF()

    GET_TARGET_PROPERTY(SOURCE_FOLDER ${ARG_TARGET} SOURCE_DIR)
    GET_TARGET_PROPERTY(BINARY_FOLDER ${ARG_TARGET} BINARY_DIR)
    GET_FILENAME_COMPONENT(MODULE "${SOURCE_FOLDER}" NAME)
    FILE(RELATIVE_PATH RELATIVE "${SOURCE_FOLDER}" "${THEME}")

    SET(GENERATED_FOLDER "${BINARY_FOLDER}/_Generated")
    SET(GENERATED_HEADER "${GENERATED_FOLDER}/${MODULE}/Theme.inl")

    # An array of no bytes does not compile, and an empty theme is no theme.
    FILE(READ "${THEME}" CONTENT HEX)

    IF(CONTENT STREQUAL "")

        MESSAGE(FATAL_ERROR "ZyEmbedTheme: ${THEME} is empty.")

    ENDIF()

    # Every byte is written as a number, sixteen to a row, so a theme of any size and any character compiles alike.
    STRING(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " CONTENT "${CONTENT}")
    STRING(REPEAT "0x[0-9a-f][0-9a-f], " 16 ROW)
    STRING(REGEX REPLACE "(${ROW})" "\\1\n" CONTENT "${CONTENT}")
    STRING(REGEX REPLACE " \n" "\n    " CONTENT "${CONTENT}")
    STRING(STRIP "${CONTENT}" CONTENT)

    SET(HEADER "// Generated by ZyEmbedTheme from ${MODULE}/${RELATIVE}: edit the theme, never this file.\n\n")
    STRING(APPEND HEADER "#pragma once\n\n")
    STRING(APPEND HEADER "static const Byte kTheme[] =\n{\n    ${CONTENT}\n};\n")

    # Written only when the bytes changed, so configuring again rebuilds nothing the theme did not change.
    FILE(CONFIGURE OUTPUT "${GENERATED_HEADER}" CONTENT "${HEADER}" @ONLY)

    SET_PROPERTY(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${THEME}")

    TARGET_SOURCES(${ARG_TARGET} PRIVATE "${THEME}" "${GENERATED_HEADER}")
    TARGET_INCLUDE_DIRECTORIES(${ARG_TARGET} PRIVATE "${GENERATED_FOLDER}")

ENDFUNCTION()