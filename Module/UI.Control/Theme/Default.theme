    },
    "Expander.Header.Label": {
      "Base": "Button.Label"
    },
    "Expander.Arrow": {
      "Base": "Button.Label",
      "Tint": "Gold"
    },
    "Expander.Content": {
      "Padding": [
        12,
        4
      ]
    },
    "Window": {
      "Background": "#141720F2",
      "Border": "Edge",
      "BorderWidth": 1,
      "Radius": 8,
