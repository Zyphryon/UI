      "Radius": 6,
      "Padding": 4,
      "Shadow": {
        "Color": "#00000073",
        "Offset": [
          0,
          6
        ],
        "Blur": 16
      },
      "Enter": "Drop",
      "Exit": "FadeOut"
    },
    "Combobox.List": {
      "Base": "Listbox",
      "Height": 120,
      "Background": "#00000000",
      "Padding": 0
    },
    "Radio": {
      "Gap": 8
    },
    "Radio.Box": {
      "Width": 18,
      "Height": 18,
      "Background": "Field",
      "Border": "Edge",
      "BorderWidth": 1,
      "Radius": 9,
      "Padding": 4,
      "Transition": 0.12,
      "When": {
        "Hover": {
          "Border": "Gold",
