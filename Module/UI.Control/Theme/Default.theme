{
  "Fonts": {
    "Body": null
  },
  "Colors": {
    "Ink": "#D9DBE6",
    "Gold": "#F0D98F",
    "Field": "#1C2129",
    "Edge": "#4D5466",
    "Accent": "#2E6BDE",
    "Raised": "#2E3645"
  },
  "Animations": {
    "FadeIn": {
      "Duration": 0.15,
      "Easing": "OutQuad",
      "Keys": [
        {
          "At": 0,
          "Opacity": 0
        },
        {
          "At": 1,
          "Opacity": 1
        }
      ]
    },
    "FadeOut": {
      "Duration": 0.12,
      "Easing": "InQuad",
      "Keys": [
        {
          "At": 0,
          "Opacity": 1
        },
        {
          "At": 1,
          "Opacity": 0
        }
      ]
    },
    "Drop": {
      "Duration": 0.16,
      "Easing": "OutCubic",
      "Keys": [
        {
          "At": 0,
          "Opacity": 0,
          "Translate": [
            0,
            -6
          ]
        },
        {
          "At": 1,
          "Opacity": 1,
          "Translate": [
            0,
            0
          ]
        }
      ]
    },
    "Pop": {
      "Duration": 0.18,
      "Easing": "OutBack",
      "Keys": [
        {
          "At": 0,
          "Opacity": 0,
          "Scale": 0.92
        },
        {
          "At": 1,
          "Opacity": 1,
          "Scale": 1
        }
      ]
    },
    "Pulse": {
      "Duration": 1.2,
      "Repeat": 0,
      "Easing": "InOutSine",
      "Keys": [
        {
          "At": 0,
          "Scale": 1
        },
        {
          "At": 0.5,
          "Scale": 1.06
        },
        {
          "At": 1,
          "Scale": 1
        }
      ]
    },
    "Spin": {
      "Duration": 1,
      "Repeat": 0,
      "Easing": "Linear",
      "Keys": [
        {
          "At": 0,
          "Rotate": 0
        },
        {
          "At": 1,
          "Rotate": 360
        }
      ]
    }
  },
  "Styles": {
    "Label": {
      "Font": "Body",
      "Size": 16,
      "Tint": "Ink"
    },
    "Title": {
      "Base": "Label",
      "Size": 22,
      "Tint": "Gold"
    },
    "Card": {
      "Background": "#FFFFFF0F",
      "Border": "#3B404F",
      "BorderWidth": 1,
      "Radius": 10,
      "Padding": 16,
      "Gap": 10,
      "Shadow": {
        "Color": "#0000004D",
        "Offset": [
          0,
          4
        ],
        "Blur": 12
      }
    },
    "Button": {
      "Background": "Raised",
      "Radius": 6,
      "Padding": [
        12,
        6
      ],
      "Shadow": {
        "Color": "#00000059",
        "Offset": [
          0,
          2
        ],
        "Blur": 6
      },
      "Transition": 0.12,
      "When": {
        "Hover": {
          "Background": "#404A5E",
          "Glow": {
            "Color": [
              "Gold",
              0.18
            ],
            "Blur": 8
          }
        },
        "Press": {
          "Background": "#212633",
          "Scale": 0.97
        },
        "Focus": {
          "Border": "Gold",
          "BorderWidth": 1
        },
        "Disabled": {
          "Opacity": 0.45
        }
      }
    },
    "Button.Label": {
      "Base": "Label",
      "Size": 15,
      "Tint": "#FFFFFF"
    },
    "Checkbox": {
      "Gap": 8
    },
    "Checkbox.Box": {
      "Width": 18,
      "Height": 18,
      "Background": "Field",
      "Border": "Edge",
      "BorderWidth": 1,
      "Radius": 4,
      "Padding": 4,
      "Transition": 0.12,
      "When": {
        "Hover": {
          "Border": "Gold",
          "BorderWidth": 1
        },
        "Focus": {
          "Border": "Gold",
          "BorderWidth": 1
        }
      }
    },
    "Checkbox.Mark": {
      "Background": "Gold",
      "Radius": 2,
      "Opacity": 0,
      "Scale": 0.6,
      "Transition": {
        "Duration": 0.14,
        "Easing": "OutBack"
      },
      "When": {
        "Checked": {
          "Opacity": 1,
          "Scale": 1
        }
      }
    },
    "Checkbox.Label": {
      "Base": "Label",
      "Size": 15
    },
    "Slider": {
      "Height": 6,
      "Background": "Field",
      "Radius": 3,
      "Fill": "Accent"
    },
    "Slider.Thumb": {
      "Width": 16,
      "Height": 16,
      "Radius": 8,
      "Background": "#D1D6E6",
      "Transition": 0.1,
      "When": {
        "Hover": {
          "Background": "#FFFFFF",
          "Glow": {
            "Color": [
              "Gold",
              0.35
            ],
            "Blur": 8,
            "Spread": 1
          }
        },
        "Press": {
          "Background": "Gold"
        },
        "Focus": {
          "Border": "Gold",
          "BorderWidth": 2
        }
      }
    },
    "Listbox": {
      "Background": "#0F121A",
      "Radius": 6,
      "Padding": 4,
      "Gap": 2,
      "Thumb": "Gold",
      "Border": "#00000000",
      "BorderWidth": 1,
      "When": {
        "Focus": {
          "Border": "Gold",
          "BorderWidth": 1
        }
      }
    },
    "ListItem": {
      "Padding": [
        8,
        4
      ],
      "Radius": 4,
      "Background": "#00000000",
      "Transition": 0.1,
      "When": {
        "Hover": {
          "Background": "#FFFFFF12"
        },
        "Marked": {
          "Background": [
            "Gold",
            0.22
          ]
        },
        "Selected": {
          "Background": [
            "Accent",
            0.65
          ]
        },
        "Disabled": {
          "Opacity": 0.4,
          "Background": "#00000000"
        }
      }
    },
    "ListItem.Label": {
      "Base": "Label",
      "Size": 14
    },
    "Repeater": {
      "Background": "#0F121A",
      "Radius": 6,
      "Padding": 4,
      "Gap": 2,
      "Thumb": "Gold",
      "Border": "#00000000",
      "BorderWidth": 1,
      "When": {
        "Focus": {
          "Border": "Gold",
          "BorderWidth": 1
        }
      }
    },
    "Repeater.Item": {
      "Base": "ListItem"
    },
    "Combobox": {
      "Base": "Button",
      "Gap": 8
    },
    "Combobox.Label": {
      "Base": "Button.Label"
    },
    "Combobox.Arrow": {
      "Base": "Button.Label",
      "Tint": "#99A3B8"
    },
    "Combobox.Popup": {
      "Background": "#14171FFA",
