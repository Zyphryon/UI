    "Outline": {
      "Background": "#0F121A",
      "Radius": 6,
      "Border": "Edge",
      "BorderWidth": 1,
      "Padding": 1
    },
    "Outline.List": {
      "Base": "Repeater",
      "Background": "#00000000",
      "Radius": 0,
      "Padding": 3,
      "Gap": 1,
      "When": {
        "Focus": {
          "Border": "#00000000",
          "BorderWidth": 1
        }
      }
    },
    "Outline.List.Item": {
      "Base": "ListItem",
      "Padding": [
        4,
        2,
        6,
        2
      ],
      "Gap": 2,
      "When": {
        "DropHover": {
          "Border": "Gold",
          "BorderWidth": 1
        }
      }
    },
    "Outline.Marker": {
      "Background": "Gold",
      "Height": 2,
      "Radius": 1
    },
    "Outline.Indent": {
      "Width": 16
    },
    "Outline.Arrow": {
      "Base": "Label",
      "Size": 12,
      "Tint": "Gold",
      "Width": 16,
      "Alignment": "Center",
      "Rotate": 0,
      "Transition": 0.12,
      "When": {
        "Checked": {
          "Rotate": 90
        },
        "Hover": {
          "Tint": "#FFFFFF"
        },
        "Disabled": {
          "Opacity": 0
        }
      }
    },
    "Outline.Content": {
      "Gap": 6
    },
    "Outline.Label": {
      "Base": "Label",
      "Size": 14
    },
    "Dock": {},
    "Dock.Split": {
      "Base": "Splitter"
    },
    "Dock.Split.Pane": {
      "Base": "Splitter.Pane"
    },
    "Dock.Split.Bar": {
      "Base": "Splitter.Bar"
    },
    "Dock.Region": {
      "Base": "Tabs"
    },
    "Dock.Region.Header": {
      "Base": "Tabs.Header"
    },
    "Dock.Region.Tab": {
      "Base": "Tabs.Tab",
      "Padding": [
        10,
        4
      ],
      "Radius": 4
    },
    "Dock.Region.Tab.Label": {
      "Base": "Tabs.Tab.Label",
      "Size": 13
    },
    "Dock.Region.Pages": {
      "Base": "Tabs.Pages",
      "Padding": 6
    },
    "Dock.Region.Page": {
      "Gap": 6
    },
    "Dock.Panel": {
      "Gap": 6
    },
    "Dock.Window": {
      "Base": "Window"
    },
    "Dock.Window.Bar": {
      "Base": "Window.Bar"
    },
    "Dock.Window.Title": {
      "Base": "Window.Title",
      "Size": 15
    },
    "Dock.Window.Close": {
      "Base": "Window.Close"
    },
    "Dock.Window.Close.Label": {
      "Base": "Window.Close.Label"
    },
    "Dock.Window.Content": {
      "Base": "Window.Content",
      "Padding": 8
    },
    "Dock.Overlay": {},
    "Dock.Target": {
      "Background": [
        "Accent",
        0.55
      ],
      "Border": "Edge",
      "BorderWidth": 1,
      "Radius": 6,
      "Transition": 0.08,
      "When": {
        "DropHover": {
          "Background": [
            "Gold",
            0.9
          ],
          "Border": "Gold",
          "BorderWidth": 1
        }
      }
    },
    "Dock.Preview": {
      "Background": [
        "Gold",
        0.14
      ],
      "Border": "Gold",
      "BorderWidth": 1,
      "Radius": 4
    }
  }
}