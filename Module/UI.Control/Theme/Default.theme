      "Fill": "Accent"
    },
    "Progress.Label": {
      "Base": "Label",
      "Size": 12,
      "Tint": "Ink",
      "Alignment": "Center"
    },
    "Tabs": {},
    "Tabs.Header": {
      "Gap": 2
    },
    "Tabs.Tab": {
      "Base": "Button",
      "Background": "#FFFFFF0A",
      "Shadow": {},
      "Gap": 6,
      "When": {
        "Hover": {
          "Background": "#FFFFFF1A"
        },
        "Selected": {
          "Background": [
            "Accent",
            0.65
          ]
        }
      }
    },
    "Tabs.Tab.Label": {
      "Base": "Button.Label"
    },
    "Tabs.Close": {
      "Background": "#00000000",
      "Radius": 3,
      "Padding": [
        4,
        0
      ],
      "Transition": 0.08,
      "When": {
        "Hover": {
          "Background": "#FFFFFF26"
        },
        "Press": {
          "Background": "#FFFFFF40"
        }
      }
    },
    "Tabs.Close.Label": {
