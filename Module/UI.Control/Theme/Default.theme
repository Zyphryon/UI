      "Transition": {
        "Duration": 0.14,
        "Easing": "OutBack"
      },
      "When": {
        "Checked": {
          "Opacity": 1,
          "Scale": 1
        }
      }
    },
    "Radio.Label": {
      "Base": "Label",
      "Size": 15
    },
    "Progress": {
      "Height": 18,
